ninja_required_version = 1.3
cxx = c++
nvcc = /usr/local/cuda/bin/nvcc

cflags = -pthread -B /root/miniconda3/envs/compressai-s/compiler_compat -Wno-unused-result -Wsign-compare -DNDEBUG -fwrapv -O2 -Wall -fPIC -O2 -isystem /root/miniconda3/envs/compressai-s/include -fPIC -O2 -isystem /root/miniconda3/envs/compressai-s/include -fPIC -I/root/miniconda3/envs/compressai-s/lib/python3.10/site-packages/torch/include -I/root/miniconda3/envs/compressai-s/lib/python3.10/site-packages/torch/include/torch/csrc/api/include -I/usr/local/cuda/include -I/root/miniconda3/envs/compressai-s/include/python3.10 -c
post_cflags = -O3 -std=c++17 -DTORCH_API_INCLUDE_EXTENSION_H '-DPYBIND11_COMPILER_TYPE="_gcc"' '-DPYBIND11_STDLIB="_libstdcpp"' '-DPYBIND11_BUILD_ABI="_cxxabi1018"' -DTORCH_EXTENSION_NAME=_warp_div
cuda_cflags = -I/root/miniconda3/envs/compressai-s/lib/python3.10/site-packages/torch/include -I/root/miniconda3/envs/compressai-s/lib/python3.10/site-packages/torch/include/torch/csrc/api/include -I/usr/local/cuda/include -I/root/miniconda3/envs/compressai-s/include/python3.10 -c
cuda_post_cflags = -D__CUDA_NO_HALF_OPERATORS__ -D__CUDA_NO_HALF_CONVERSIONS__ -D__CUDA_NO_BFLOAT16_CONVERSIONS__ -D__CUDA_NO_HALF2_OPERATORS__ --expt-relaxed-constexpr --compiler-options ''"'"'-fPIC'"'"'' -O3 -DTORCH_API_INCLUDE_EXTENSION_H '-DPYBIND11_COMPILER_TYPE="_gcc"' '-DPYBIND11_STDLIB="_libstdcpp"' '-DPYBIND11_BUILD_ABI="_cxxabi1018"' -DTORCH_EXTENSION_NAME=_warp_div -gencode=arch=compute_90,code=sm_90 -std=c++17
cuda_dlink_post_cflags = 
sycl_dlink_post_cflags = 
ldflags = 

rule compile
  command = $cxx -MMD -MF $out.d $cflags -c $in -o $out $post_cflags
  depfile = $out.d
  deps = gcc

rule cuda_compile
  depfile = $out.d
  deps = gcc
  command = $nvcc --generate-dependencies-with-compile --dependency-output $out.d $cuda_cflags -c $in -o $out $cuda_post_cflags







build /hwj/project/fast-compressai/build/temp.linux-x86_64-cpython-310/src/fast_compressai/coders/cuda/ans_gpu.o: compile /hwj/project/fast-compressai/src/fast_compressai/coders/cuda/ans_gpu.cpp
build /hwj/project/fast-compressai/build/temp.linux-x86_64-cpython-310/src/fast_compressai/coders/cuda/warp_ans_kernel.o: cuda_compile /hwj/project/fast-compressai/src/fast_compressai/coders/cuda/warp_ans_kernel.cu
build /hwj/project/fast-compressai/build/temp.linux-x86_64-cpython-310/src/fast_compressai/coders/cuda/warp_ans_kernel_v2.o: cuda_compile /hwj/project/fast-compressai/src/fast_compressai/coders/cuda/warp_ans_kernel_v2.cu
build /hwj/project/fast-compressai/build/temp.linux-x86_64-cpython-310/src/fast_compressai/coders/cuda/warp_index_check.o: cuda_compile /hwj/project/fast-compressai/src/fast_compressai/coders/cuda/warp_index_check.cu








